# コピーして .env を作る: cp .env.example .env
# 実キーは .env にだけ書く（.env は .gitignore 済み）。キーを増やしたらこのファイルも同期する。

# --- xiaozhi-server ---
# Mac の LAN IP（端末と疑似デバイスが到達できるアドレス）。例: ipconfig getifaddr en0
SERVER_LAN_IP=192.168.x.x

# --- Vercel AI Gateway（LLM と Jev の両方をこの 1 本のキーで呼ぶ）---
# 変数名は Vercel 公式に合わせる（okf/external/vercel-ai-gateway.md）
AI_GATEWAY_API_KEY=REPLACE_ME
# ランタイム LLM。省略時 openai/gpt-6-luna（okf/external/openai-gpt-6-luna.md）
LLM_MODEL=openai/gpt-6-luna
# llm-proxy が注入する推論努力。function calling を使うなら none 必須
LLM_REASONING_EFFORT=none
